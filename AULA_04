# Exercício 4 — Motor de Decisioning SD-WAN Zero-Trust

## Objetivo

Neste exercício, o algoritmo realiza a seleção de uma rota entre:

```text
Origem  = 0
Destino = 11
```

A decisão considera:

* **12 roteadores**, numerados de `0` a `11`;
* latência dos enlaces;
* perda de pacotes;
* reputação de segurança dos nós;
* penalidade de `5000` caso algum nó da rota tenha reputação inferior a `50`;
* pesos `w1` e `w2`;
* amostragem estocástica;
* `np.random.seed(2026)` para reprodutibilidade.

---

## Função de Fitness

A função utilizada é:

$$
Fitness(X) =
w_1 \times LatênciaTotal(X)
+
w_2 \times PerdaPacotesTotal(X)
+
PenalidadeSegurança(X)
$$

Neste código:

```python
W1 = 1.0
W2 = 10.0

PENALIDADE_SEGURANCA = 5000.0
```

A implementação é:

```python
fitness = (
    W1 * latencia_total
    + W2 * perda_total
    + penalidade
)
```

---

## Código completo

```python
"""
============================================================
DESAFIO AC-1
Motor de Decisioning SD-WAN Zero-Trust
============================================================

RELATÓRIO TÉCNICO

O algoritmo realiza a seleção de uma rota entre o nó 0
(origem) e o nó 11 (destino).

O fitness considera:

    Fitness(X) =
        w1 * LatenciaTotal(X)
        + w2 * PerdaPacotesTotal(X)
        + PenalidadeSeguranca(X)

A penalidade de segurança é de 5000 quando qualquer nó
pertencente à rota apresenta reputação inferior a 50.

Nós com reputação < 50 são considerados não confiáveis.

A semente 2026 é utilizada para garantir
reprodutibilidade da amostragem estocástica.

Após a execução, o programa informa a rota selecionada,
sua latência, perda de pacotes, reputações e fitness.
============================================================
"""

import numpy as np


# ==========================================================
# CONFIGURAÇÃO
# ==========================================================

np.random.seed(2026)

NUM_NOS = 12
ORIGEM = 0
DESTINO = 11

W1 = 1.0
W2 = 10.0

PENALIDADE_SEGURANCA = 5000.0


# ==========================================================
# MATRIZES DE ATRIBUTOS
# ==========================================================

# Matriz de adjacência.
# 1 = enlace disponível
# 0 = enlace indisponível

matriz_adjacencia = np.zeros(
    (NUM_NOS, NUM_NOS),
    dtype=int
)

for i in range(NUM_NOS):

    for j in range(i + 1, NUM_NOS):

        if np.random.rand() < 0.35:

            matriz_adjacencia[i, j] = 1
            matriz_adjacencia[j, i] = 1


# Garante uma cadeia básica conectando todos os nós.

for i in range(NUM_NOS - 1):

    matriz_adjacencia[i, i + 1] = 1
    matriz_adjacencia[i + 1, i] = 1


# Latência dos enlaces
matriz_latencia = np.random.uniform(
    5,
    100,
    (NUM_NOS, NUM_NOS)
)

# Perda de pacotes
matriz_perda = np.random.uniform(
    0,
    10,
    (NUM_NOS, NUM_NOS)
)


# Torna as matrizes simétricas

matriz_latencia = (
    matriz_latencia
    + matriz_latencia.T
) / 2

matriz_perda = (
    matriz_perda
    + matriz_perda.T
) / 2


# Reputação de segurança dos nós
reputacao = np.random.uniform(
    0,
    100,
    NUM_NOS
)


# ==========================================================
# FUNÇÃO DE FITNESS
# ==========================================================

def calcular_fitness(rota):

    latencia_total = 0.0
    perda_total = 0.0

    # Calcula métricas dos enlaces
    for i in range(len(rota) - 1):

        origem = rota[i]
        destino = rota[i + 1]

        latencia_total += (
            matriz_latencia[origem, destino]
        )

        perda_total += (
            matriz_perda[origem, destino]
        )

    # Verifica segurança dos nós
    nos_inseguros = [
        no
        for no in rota
        if reputacao[no] < 50
    ]

    penalidade = 0.0

    if len(nos_inseguros) > 0:
        penalidade = PENALIDADE_SEGURANCA

    fitness = (
        W1 * latencia_total
        + W2 * perda_total
        + penalidade
    )

    return (
        fitness,
        latencia_total,
        perda_total,
        penalidade,
        nos_inseguros
    )


# ==========================================================
# GERAÇÃO DE ROTAS
# ==========================================================

def gerar_rota():

    rota = [ORIGEM]

    atual = ORIGEM

    visitados = {
        ORIGEM
    }

    while atual != DESTINO:

        vizinhos = [
            no
            for no in range(NUM_NOS)
            if matriz_adjacencia[atual, no] == 1
            and no not in visitados
        ]

        # Se não houver vizinho disponível,
        # retorna None.
        if len(vizinhos) == 0:
            return None

        # Dá preferência ao destino quando ele
        # estiver diretamente conectado.
        if DESTINO in vizinhos:
            proximo = DESTINO

        else:
            proximo = np.random.choice(
                vizinhos
            )

        rota.append(proximo)

        visitados.add(proximo)

        atual = proximo

    return rota


# ==========================================================
# AMOSTRAGEM ESTOCÁSTICA
# ==========================================================

NUM_AMOSTRAS = 10000

melhor_rota = None
melhor_resultado = None

for _ in range(NUM_AMOSTRAS):

    rota = gerar_rota()

    if rota is None:
        continue

    resultado = calcular_fitness(rota)

    fitness = resultado[0]

    if (
        melhor_resultado is None
        or fitness < melhor_resultado[0]
    ):

        melhor_rota = rota.copy()

        melhor_resultado = resultado


# ==========================================================
# RESULTADO
# ==========================================================

if melhor_rota is None:

    print(
        "Não foi encontrada nenhuma rota "
        "entre os nós 0 e 11."
    )

else:

    (
        fitness,
        latencia_total,
        perda_total,
        penalidade,
        nos_inseguros
    ) = melhor_resultado

    print("\n")
    print("=" * 60)
    print("RESULTADO DO MOTOR SD-WAN ZERO-TRUST")
    print("=" * 60)

    print(
        f"Rota selecionada: "
        f"{' -> '.join(map(str, melhor_rota))}"
    )

    print(
        f"Latência total: "
        f"{latencia_total:.2f} ms"
    )

    print(
        f"Perda de pacotes total: "
        f"{perda_total:.2f} %"
    )

    print(
        f"Penalidade de segurança: "
        f"{penalidade:.2f}"
    )

    print(
        f"Fitness final: "
        f"{fitness:.2f}"
    )

    print("\nReputação dos nós da rota:")

    for no in melhor_rota:

        status = (
            "NÃO CONFIÁVEL"
            if reputacao[no] < 50
            else "CONFIÁVEL"
        )

        print(
            f"Nó {no}: "
            f"{reputacao[no]:.2f} "
            f"-> {status}"
        )

    print("\nNós penalizados:")

    if len(nos_inseguros) == 0:

        print(
            "Nenhum nó com reputação inferior a 50."
        )

    else:

        print(nos_inseguros)

    print("=" * 60)
```

